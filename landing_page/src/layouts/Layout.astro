---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	keywords?: string;
}

const { 
	title, 
	description = "Aplikasi Kasir Pintar Multi-Platform (Android, Windows & Web) untuk UMKM, Toko Retail, Kelontong & Cafe. Dilengkapi cetak struk Bluetooth, buku kasbon, asisten AI & toko online.",
	image = "/og-image.png",
	keywords = "aplikasi kasir, aplikasi pos, kasir toko kelontong, kasir warung, kasir cafe, cetak struk bluetooth, aplikasi kasir gratis, kasir umkm, software pos indonesia, kasir online, aplikasi kasbon tempo, pos kasir android"
} = Astro.props;

const siteUrl = "https://pos.mudahkan.online";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

// Schema.org Structured Data
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			"@id": `${siteUrl}/#software`,
			"name": "Mangga POS",
			"description": description,
			"url": siteUrl,
			"image": `${siteUrl}/logo.png`,
			"operatingSystem": "Android, Windows, Web Browser",
			"applicationCategory": "BusinessApplication",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "IDR",
				"availability": "https://schema.org/InStock"
			},
			"downloadUrl": "https://play.google.com/store/apps/details?id=online.mudahkan.manggapos",
			"installUrl": "https://play.google.com/store/apps/details?id=online.mudahkan.manggapos",
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": "4.9",
				"ratingCount": "128",
				"bestRating": "5",
				"worstRating": "1"
			},
			"featureList": [
				"Aplikasi Kasir POS Multi-Platform (HP, Tablet, Windows & Web)",
				"Cetak Struk Printer Bluetooth Thermal & USB",
				"Buku Kasbon & Pencatatan Tempo Pelanggan",
				"Kirim Tagihan & Nota Otomatis via WhatsApp",
				"Asisten AI Interaktif & Analisis Prediksi Stok",
				"Integrasi Toko Online & Pesanan Masuk Real-Time"
			]
		},
		{
			"@type": "Organization",
			"@id": `${siteUrl}/#organization`,
			"name": "Mangga POS - Mudahkan Online",
			"url": siteUrl,
			"logo": `${siteUrl}/logo.png`,
			"sameAs": [
				"https://play.google.com/store/apps/details?id=online.mudahkan.manggapos"
			]
		}
	]
};
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:site_name" content="Mangga POS" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageUrl} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

		<!-- Google AdSense -->
		<meta name="google-adsense-account" content="ca-pub-4602657974905060">
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4602657974905060" crossorigin="anonymous"></script>

		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-slate-50 text-slate-900 selection:bg-orange-100 selection:text-orange-900 antialiased font-['Plus_Jakarta_Sans',sans-serif]">
		<slot />
	</body>
</html>
