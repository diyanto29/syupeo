---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Menu Digital | Memuat Toko...">
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap');
    
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --primary-light: #eef2ff;
      --accent: #10b981;
      --accent-light: #ecfdf5;
    }

    html {
      background-color: #0b0f19 !important;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
      -webkit-tap-highlight-color: transparent;
      scroll-behavior: smooth;
    }

    body {
      background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0b0f19 70%) !important;
      margin: 0;
      display: flex;
      justify-content: center;
      min-height: 100vh;
      color: #1e293b;
    }

    .app-shell {
      width: 100%;
      max-width: 520px;
      background-color: #ffffff;
      min-height: 100vh;
      position: relative;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4), 0 0 100px rgba(99, 102, 241, 0.15);
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .glass-header {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    }

    .glass-cart {
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.5), 0 0 30px rgba(79, 70, 229, 0.25);
    }

    .product-card {
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .product-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
    }
    .product-card:active {
      transform: scale(0.98);
    }

    @keyframes popIn {
      0% { transform: scale(0.8); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes pulseSoft {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .animate-pulse-soft {
      animation: pulseSoft 2s infinite ease-in-out;
    }

    .shimmer {
      background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
  </style>

  <!-- Container App Shell -->
  <div class="app-shell" id="main-content" class="opacity-0 transition-opacity duration-500 pb-32">
    
    <!-- Hero / Store Banner -->
    <div class="relative h-64 bg-slate-900 overflow-hidden flex-shrink-0">
      <!-- Background Banner -->
      <div id="hero-bg" class="absolute inset-0 bg-cover bg-center transition-all duration-700 opacity-60 scale-105"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent"></div>
      
      <!-- Top Action Badges -->
      <div class="absolute top-4 inset-x-4 flex justify-between items-center z-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900/60 backdrop-blur-md text-[11px] font-bold text-white border border-white/10 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="status-text">Buka • Terima Pesanan</span>
        </span>
        <div class="flex items-center gap-2">
          <button id="btn-track-header" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900/60 backdrop-blur-md text-xs font-bold text-white border border-white/10 hover:bg-slate-900 hover:border-indigo-400 transition-all active:scale-95 shadow-sm" title="Lacak Status Pesanan">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Lacak Pesanan</span>
          </button>
          <button id="btn-share" class="w-9 h-9 rounded-full bg-slate-900/60 backdrop-blur-md flex items-center justify-center text-white border border-white/10 hover:bg-slate-900 transition-all active:scale-90" title="Bagikan Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          </button>
        </div>
      </div>

      <!-- Store Profile Info Inside Hero -->
      <div class="absolute bottom-5 inset-x-5 flex items-end gap-3.5 z-10">
        <!-- Logo -->
        <div id="shop-logo" class="w-16 h-16 bg-white rounded-2xl shadow-2xl flex items-center justify-center text-2xl font-black text-indigo-600 border-2 border-white/90 overflow-hidden flex-shrink-0">
          <span id="shop-logo-fallback">-</span>
          <img id="shop-logo-img" src="" class="w-full h-full object-cover hidden" alt="Logo Toko" />
        </div>
        
        <!-- Info -->
        <div class="flex-1 min-w-0 pb-0.5">
          <div class="flex items-center gap-1.5 mb-1">
            <h1 id="shop-name" class="text-xl font-extrabold text-white leading-tight truncate">Memuat Toko...</h1>
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <p id="shop-desc" class="text-slate-300 text-xs font-medium line-clamp-1">Menu Digital & Pemesanan Mandiri</p>
          <div class="flex items-center gap-2 mt-1.5 text-[11px] text-slate-300 font-semibold">
            <span id="shop-address" class="truncate max-w-[200px]">📍 Indonesia</span>
            <span>•</span>
            <span class="text-emerald-400 font-bold">Resmi POS</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Order Floating Banner (Rendered dynamically if an order is active) -->
    <div id="active-order-banner" class="hidden px-4 pt-3 pb-1 bg-slate-900">
      <div class="p-3 bg-gradient-to-r from-indigo-950 via-slate-900 to-indigo-900 rounded-2xl border border-indigo-500/40 text-white shadow-xl flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-9 h-9 rounded-xl bg-indigo-600/30 border border-indigo-400/40 flex items-center justify-center flex-shrink-0 text-base">
            🛵
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-black uppercase tracking-wider text-indigo-300">Pesanan Aktif</span>
              <span class="text-[10px] text-slate-400">•</span>
              <span id="banner-order-inv" class="text-[11px] font-extrabold text-white truncate">INV-xxxxxx</span>
            </div>
            <p id="banner-order-status" class="text-xs text-amber-300 font-bold truncate">Menunggu Konfirmasi...</p>
          </div>
        </div>
        <button id="btn-banner-view" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold flex-shrink-0 transition-all shadow-md active:scale-95">
          Lihat Status
        </button>
      </div>
    </div>

    <!-- Quick Store Action Chips -->
    <div class="px-5 py-3.5 bg-slate-50 border-b border-slate-100 flex items-center gap-2 overflow-x-auto no-scrollbar">
      <a id="btn-wa-direct" href="#" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 shadow-2xl hover:border-emerald-500 hover:text-emerald-600 transition-all flex-shrink-0">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.825z"/></svg>
        Hubungi WhatsApp
      </a>
      <button id="btn-info-sheet" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 shadow-2xl hover:border-indigo-500 hover:text-indigo-600 transition-all flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        Info Toko
      </button>
      <div class="ml-auto text-[10px] font-bold text-slate-400 flex items-center gap-1 flex-shrink-0">
        <span>Katalog Aktif</span>
      </div>
    </div>

    <!-- Sticky Search & Category Bar -->
    <div class="sticky top-0 z-30 glass-header px-5 pt-3.5 pb-3">
      <!-- Search Box -->
      <div class="relative">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Cari makanan, minuman, menu favorit..." 
          class="w-full bg-slate-100/80 border border-slate-200/60 rounded-2xl py-3 pl-11 pr-10 text-xs font-semibold text-slate-800 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-indigo-600 focus:border-transparent outline-none transition-all"
        />
        <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <button id="search-clear" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Categories Pill Carousel & Layout Switcher -->
      <div class="flex items-center justify-between gap-2 mt-3">
        <div id="category-tabs" class="flex gap-2 overflow-x-auto no-scrollbar py-0.5 flex-1">
          <!-- Rendered dynamically -->
        </div>
        
        <!-- View Toggle (Grid / List) -->
        <button id="view-toggle" class="p-2 rounded-xl bg-slate-100 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 transition-all flex-shrink-0" title="Ubah Tampilan Grid/List">
          <svg id="icon-grid" class="w-4 h-4 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          <svg id="icon-list" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Product Grid Content -->
    <div class="px-5 py-5 flex-1">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h2 id="section-title" class="text-base font-extrabold text-slate-900 tracking-tight">Semua Menu</h2>
          <p id="section-count" class="text-[11px] font-semibold text-slate-400">Memuat item...</p>
        </div>
      </div>

      <!-- Menu Grid -->
      <div id="menu-grid" class="grid grid-cols-2 gap-3.5 transition-all">
        <!-- Skeleton Loaders -->
        <div class="bg-white rounded-3xl p-3 border border-slate-100 shadow-sm flex flex-col">
          <div class="w-full aspect-square rounded-2xl shimmer mb-3"></div>
          <div class="h-4 w-3/4 rounded-md shimmer mb-2"></div>
          <div class="h-4 w-1/2 rounded-md shimmer mt-auto"></div>
        </div>
        <div class="bg-white rounded-3xl p-3 border border-slate-100 shadow-sm flex flex-col">
          <div class="w-full aspect-square rounded-2xl shimmer mb-3"></div>
          <div class="h-4 w-3/4 rounded-md shimmer mb-2"></div>
          <div class="h-4 w-1/2 rounded-md shimmer mt-auto"></div>
        </div>
      </div>
    </div>

    <!-- Footer Branding -->
    <footer class="mt-auto px-5 py-8 text-center bg-slate-50 border-t border-slate-100">
      <div class="flex items-center justify-center gap-2 mb-2">
        <div class="w-5 h-5 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-[10px] font-black">M</div>
        <p class="text-xs font-extrabold text-slate-800">Didukung oleh Mangga POS</p>
      </div>
      <p class="text-[11px] text-slate-400 font-medium">Solusi Kasir & Menu Digital UMKM Indonesia</p>
      <div class="mt-3 flex items-center justify-center gap-3 text-[11px] font-bold text-indigo-600">
        <a href="https://pos.mudahkan.online" target="_blank" class="hover:underline">Bikin Toko Online Gratis</a>
        <span>•</span>
        <a href="https://pos.mudahkan.online/panduan" target="_blank" class="hover:underline">Panduan</a>
      </div>
    </footer>

    <!-- ── Floating Cart Bar ──────────────────────────────────────── -->
    <div id="cart-float" class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[92%] max-w-[460px] glass-cart text-white rounded-[28px] p-3 pl-4 flex items-center justify-between transition-all duration-300 z-50 transform translate-y-32 opacity-0 pointer-events-none cursor-pointer">
      <div class="flex items-center gap-3">
        <div class="relative w-11 h-11 bg-indigo-600 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-indigo-500/40">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          <span id="cart-badge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-slate-900 animate-pop">0</span>
        </div>
        <div>
          <p id="cart-count-text" class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">0 Produk</p>
          <p id="cart-total" class="font-black text-base text-white leading-tight">Rp 0</p>
        </div>
      </div>
      <button class="bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-2xl font-bold text-xs flex items-center gap-1.5 shadow-md transition-all active:scale-95">
        <span>Lihat Pesanan</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

    <!-- ── Variant Selection Bottom Sheet ───────────────────────────── -->
    <div id="variant-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-[110] flex items-end justify-center opacity-0 pointer-events-none transition-opacity duration-300">
      <div class="bg-white w-full max-w-[520px] rounded-t-[36px] p-6 shadow-2xl transform translate-y-full transition-transform duration-300 max-h-[85vh] overflow-y-auto no-scrollbar">
        <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-6"></div>
        <div id="variant-content">
          <!-- Dynamic variant picker injected here -->
        </div>
        <button id="add-variant-to-cart" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-4 rounded-2xl font-extrabold text-sm shadow-xl shadow-indigo-200 mt-6 active:scale-95 transition-all flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Tambah ke Keranjang
        </button>
        <button onclick="window.closeVariantModal()" class="w-full py-3.5 text-slate-400 font-bold text-xs uppercase tracking-widest mt-1">Batal</button>
      </div>
    </div>

    <!-- ── Checkout Modal & WhatsApp Order Sheet ────────────────────── -->
    <div id="checkout-modal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-[100] flex items-end justify-center opacity-0 pointer-events-none transition-opacity duration-300">
      <div class="bg-white w-full max-w-[520px] rounded-t-[36px] p-5 sm:p-6 shadow-2xl transform translate-y-full transition-transform duration-300 max-h-[90vh] overflow-y-auto no-scrollbar flex flex-col">
        <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-5"></div>
        
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-xl font-black text-slate-900 leading-tight">Konfirmasi Pesanan</h2>
            <p class="text-xs text-slate-400 font-medium">Periksa kembali item pesanan Anda</p>
          </div>
          <button onclick="window.closeCheckout()" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <!-- Order Items List -->
        <div id="cart-items-list" class="space-y-2.5 mb-5 max-h-[35vh] overflow-y-auto no-scrollbar"></div>

        <!-- Tipe Pemesanan (Delivery / Takeaway / Dine In) -->
        <div class="mb-5">
          <label class="block text-xs font-extrabold text-slate-700 mb-2">Tipe Pemesanan</label>
          <div class="grid grid-cols-3 gap-2" id="order-type-group">
            <button type="button" class="order-type-btn active py-2.5 px-2 rounded-2xl border-2 border-indigo-600 bg-indigo-50/60 text-indigo-700 text-xs font-bold flex flex-col items-center gap-1 transition-all" data-type="Takeaway">
              <span class="text-base">🛍️</span>
              <span>Bawa Pulang</span>
            </button>
            <button type="button" class="order-type-btn py-2.5 px-2 rounded-2xl border-2 border-slate-100 bg-slate-50 text-slate-600 text-xs font-bold flex flex-col items-center gap-1 transition-all" data-type="Dine-in">
              <span class="text-base">🍽️</span>
              <span>Makan di Sini</span>
            </button>
            <button type="button" class="order-type-btn py-2.5 px-2 rounded-2xl border-2 border-slate-100 bg-slate-50 text-slate-600 text-xs font-bold flex flex-col items-center gap-1 transition-all" data-type="Delivery">
              <span class="text-base">🛵</span>
              <span>Pesan Antar</span>
            </button>
          </div>
        </div>

        <!-- Customer Form Inputs -->
        <div class="space-y-3 mb-5 bg-slate-50 p-4 rounded-2xl border border-slate-100">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Nama Pemesan <span class="text-rose-500">*</span></label>
            <input type="text" id="cust-name" placeholder="Misal: Budi Santoso" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3 text-xs font-semibold text-slate-800 outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Nomor WhatsApp <span class="text-slate-400 font-medium">(Opsional)</span></label>
            <input type="tel" id="cust-phone" placeholder="08xxxxxxxxxx (opsional)" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3 text-xs font-semibold text-slate-800 outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600" />
          </div>
          <div id="field-address" class="hidden">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Alamat Pengiriman</label>
            <textarea id="cust-address" rows="2" placeholder="Tuliskan alamat lengkap atau patokan jalan..." class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-semibold text-slate-800 outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600"></textarea>
          </div>
          <div id="field-table" class="hidden">
