---
import Layout from '../layouts/Layout.astro';
// Data akan diambil di sisi client untuk kemudahan hosting statis di Vercel/Firebase
---

<Layout title="Menu Digital | Memuat...">
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap');
    
    html {
      background-color: #0b0f19 !important;
      font-family: 'Plus Jakarta Sans', sans-serif !important;
      -webkit-tap-highlight-color: transparent;
    }
    
    body {
      background-color: #0b0f19 !important;
      margin: 0;
      display: flex;
      justify-content: center;
      min-height: 100vh;
      color: #0f172a;
    }

    .app-shell {
      width: 100%;
      max-width: 480px;
      background-color: #f8fafc;
      min-height: 100vh;
      position: relative;
      box-shadow: 0 0 80px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .app-page {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%) translateY(100%);
      width: 100%;
      max-width: 480px;
      height: 100%;
      background: #f8fafc;
      z-index: 200;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      visibility: hidden;
    }

    .app-page.active {
      transform: translateX(-50%) translateY(0);
      visibility: visible;
    }

    .shell-fixed {
      position: fixed;
      width: 100%;
      max-width: 480px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 100;
    }

    .glass-nav {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    }

    #cart-bar {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translate(-50%, 150px);
      width: 90%;
      max-width: 440px;
      z-index: 90;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    #cart-bar.visible {
      transform: translate(-50%, 0);
    }

    .category-btn {
      transition: all 0.2s ease;
    }

    .category-btn.active {
      background: #4f46e5 !important;
      color: #ffffff !important;
      box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .badge-confirmed { background: #fef3c7; color: #b45309; }
    .badge-processing { background: #dbeafe; color: #1d4ed8; }
    .badge-ready { background: #d1fae5; color: #047857; }
    .badge-completed { background: #dcfce7; color: #15803d; }
    .badge-cancelled { background: #ffe4e6; color: #be123c; }

    #loading-overlay {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      height: 100%;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: white;
    }

    .btn-gradient {
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.4);
      transition: all 0.2s ease;
    }
    .btn-gradient:active {
      transform: scale(0.97);
      opacity: 0.95;
    }

    .pop-badge {
      animation: popBadge 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popBadge {
      0% { transform: scale(0); }
      70% { transform: scale(1.3); }
      100% { transform: scale(1); }
    }

    /* Modal dialog */
    .success-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(6px);
      z-index: 500;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .success-modal-overlay.active {
      display: flex;
      animation: fadeIn 0.2s ease;
    }
    @keyframes scaleIn {
      from { transform: scale(0.6); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .animate-scale-in {
      animation: scaleIn 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
  </style>

  <div class="app-shell" id="main-shell">
    <!-- TOP NAVIGATION -->
    <header class="shell-fixed top-0 p-3">
      <nav class="glass-nav rounded-[28px] h-16 px-4 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
          <div id="biz-logo" class="w-10 h-10 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-sm shadow-md shadow-indigo-500/20">
            -
          </div>
          <div class="overflow-hidden">
            <h1 id="biz-name" class="text-xs font-black text-slate-800 leading-tight truncate max-w-[140px]">Memuat...</h1>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="table-label" class="text-[10px] font-extrabold text-indigo-600 tracking-wider uppercase">Meja #--</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <!-- Tombol Riwayat Pesanan -->
          <button id="nav-history-btn" onclick="window.showPage('history-page')" class="relative w-11 h-11 flex items-center justify-center rounded-2xl bg-white border border-slate-200/70 text-slate-600 shadow-sm hover:bg-slate-50 active:scale-95 transition-all" title="Riwayat Pesanan">
            <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="history-dot" class="absolute top-2 right-2 w-2 h-2 bg-indigo-600 rounded-full hidden"></span>
          </button>

          <!-- Tombol Keranjang -->
          <button id="nav-cart-btn" onclick="window.showPage('cart-page')" class="relative w-11 h-11 flex items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-md shadow-indigo-600/30 active:scale-95 transition-all" title="Keranjang">
            <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            <span id="cart-count-badge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-black min-w-[20px] h-5 px-1 rounded-full flex items-center justify-center hidden border-2 border-white shadow-sm">0</span>
          </button>
        </div>
      </nav>
    </header>

    <!-- MAIN BODY -->
    <main class="pt-24 pb-36 px-5 flex-1">
      <!-- HERO BANNER / SEARCH -->
      <div class="mt-2 mb-6">
        <p class="text-[11px] font-black text-indigo-600 uppercase tracking-widest mb-1">Self Order Menu</p>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight leading-snug">
          Mau Pesan <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">Apa Hari Ini?</span>
        </h2>
        
        <!-- Live Search -->
        <div class="mt-4 relative">
          <input 
            type="text" 
            id="search-input" 
            placeholder="Cari makanan, minuman, cemilan..." 
            class="w-full pl-11 pr-10 py-3.5 bg-white border border-slate-200/80 rounded-2xl text-xs font-bold text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-indigo-600/30 focus:border-indigo-600 shadow-sm transition-all"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <button id="clear-search-btn" class="absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-slate-100 text-slate-400 hidden items-center justify-center hover:bg-slate-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- ACTIVE TABLE SESSION BANNER -->
      <div id="active-table-banner" class="hidden mb-6 p-4 bg-gradient-to-r from-indigo-50/90 via-purple-50/90 to-emerald-50/50 rounded-[22px] border border-indigo-100 shadow-xs flex items-center justify-between gap-3 animate-scale-in">
        <div class="flex items-center gap-3 overflow-hidden">
          <div class="w-9 h-9 rounded-2xl bg-indigo-600 text-white flex items-center justify-center text-base shadow-xs flex-shrink-0">
            🧾
          </div>
          <div class="overflow-hidden">
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <p class="text-xs font-black text-slate-900 truncate" id="active-banner-title">Meja memiliki pesanan aktif</p>
            </div>
            <p class="text-[10px] text-slate-500 font-medium truncate" id="active-banner-desc">Menu baru akan otomatis digabung ke tagihan meja ini.</p>
          </div>
        </div>
        <button onclick="window.showPage('history-page')" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-[10px] font-black shadow-xs whitespace-nowrap active:scale-95 transition-all flex-shrink-0">
          Lihat Tagihan
        </button>
      </div>

      <!-- CATEGORY CHIPS -->
      <div id="category-list" class="flex gap-2 overflow-x-auto no-scrollbar mb-6 pb-1">
        <!-- Rendered dynamically -->
      </div>

      <!-- MENU GRID -->
      <div id="menu-grid" class="grid grid-cols-2 gap-4">
        <div class="col-span-2 py-20 flex flex-col items-center justify-center text-slate-400">
          <div class="w-10 h-10 border-4 border-slate-200 border-t-indigo-600 rounded-full animate-spin mb-4"></div>
          <p class="font-bold text-xs">Memuat katalog menu...</p>
        </div>
      </div>
    </main>

    <!-- FLOATING CART BAR -->
    <div id="cart-bar">
      <button onclick="window.showPage('cart-page')" class="w-full bg-slate-900 text-white h-16 rounded-[24px] flex items-center justify-between px-6 shadow-2xl active:scale-[0.98] transition-all">
        <div class="flex items-center gap-4">
          <div class="w-9 h-9 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-black text-sm shadow-md" id="cart-total-qty">
            0
          </div>
          <div class="text-left">
            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider leading-none mb-1">Total Sementara</p>
            <p id="cart-total-price" class="text-sm font-black text-white leading-none">Rp 0</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5 font-bold text-xs bg-white/10 px-3.5 py-2 rounded-xl">
          <span>Lihat Pesanan</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
        </div>
      </button>
    </div>

    <!-- DETAIL / VARIANT BOTTOM SHEET MODAL -->
    <div id="detail-page" class="app-page">
      <div class="relative w-full aspect-[4/3] bg-slate-100 overflow-hidden">
        <img id="detail-img" class="w-full h-full object-cover hidden" alt="Menu" />
        <div id="detail-img-fallback" class="w-full h-full flex items-center justify-center text-6xl">
          🍽️
        </div>
        <button onclick="window.hidePage('detail-page')" class="absolute top-5 left-5 w-10 h-10 bg-black/40 backdrop-blur-md rounded-full text-white flex items-center justify-center shadow-lg border border-white/20 active:scale-90 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
      </div>

      <div class="flex-1 bg-white -mt-6 rounded-t-[36px] p-6 shadow-2xl overflow-y-auto relative z-10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-1 bg-slate-200 rounded-full mx-auto mb-5"></div>
          <div class="flex justify-between items-start gap-4 mb-2">
            <h2 id="detail-name" class="text-xl font-black text-slate-900 leading-tight">Nama Menu</h2>
            <p id="detail-price" class="text-lg font-black text-indigo-600 whitespace-nowrap">Rp 0</p>
          </div>
          <p id="detail-desc" class="text-xs text-slate-500 font-medium leading-relaxed mb-6"></p>

          <!-- Variants Section -->
          <div id="detail-variants-section" class="hidden mb-6">
            <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Pilih Varian</h4>
            <div id="detail-variants-list" class="flex flex-wrap gap-2.5"></div>
          </div>

          <!-- Quantity Stepper -->
          <div class="mb-6 flex items-center justify-between p-3.5 bg-slate-50 rounded-2xl border border-slate-100">
            <span class="text-xs font-bold text-slate-700">Jumlah Pesanan</span>
            <div class="flex items-center gap-3">
              <button id="qty-minus-btn" class="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-700 font-bold active:scale-95">-</button>
              <span id="detail-qty" class="text-sm font-black text-slate-900 w-6 text-center">1</span>
              <button id="qty-plus-btn" class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold active:scale-95 shadow-sm">+</button>
            </div>
          </div>

          <!-- Notes -->
          <div class="mb-6">
            <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Catatan untuk Dapur (Opsional)</h4>
            <textarea 
              id="detail-note" 
              placeholder="Contoh: Bungkus, jangan terlalu pedas, es dipisah..." 
              class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-medium text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-indigo-600/30 focus:border-indigo-600"
              rows="2"
            ></textarea>
            <!-- Quick Chips -->
            <div class="flex flex-wrap gap-1.5 mt-2.5">
              <button type="button" class="quick-note-chip text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-400 active:scale-95 transition-all shadow-xs" data-note="🥡 Bungkus">🥡 Bungkus</button>
              <button type="button" class="quick-note-chip text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-400 active:scale-95 transition-all shadow-xs" data-note="🌶️ Pedas">🌶️ Pedas</button>
              <button type="button" class="quick-note-chip text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-400 active:scale-95 transition-all shadow-xs" data-note="🥦 Tidak Pedas">🥦 Tidak Pedas</button>
              <button type="button" class="quick-note-chip text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-400 active:scale-95 transition-all shadow-xs" data-note="🧊 Sedikit Es">🧊 Sedikit Es</button>
              <button type="button" class="quick-note-chip text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-400 active:scale-95 transition-all shadow-xs" data-note="🚫 Tanpa Bawang">🚫 Tanpa Bawang</button>
              <button type="button" class="quick-note-chip text-[11px] font-bold px-2.5 py-1 rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-400 active:scale-95 transition-all shadow-xs" data-note="🥣 Kuah Pisah">🥣 Kuah Pisah</button>
            </div>
          </div>
        </div>

        <button id="add-to-cart-btn" class="w-full btn-gradient text-white py-4 rounded-2xl font-black text-sm tracking-wide mt-4">
          + Tambah ke Keranjang
        </button>
      </div>
    </div>

    <!-- CART / KONFIRMASI PAGE -->
    <div id="cart-page" class="app-page">
      <header class="p-4 flex items-center justify-between glass-nav sticky top-0 z-50">
        <button onclick="window.hidePage('cart-page')" class="w-10 h-10 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-800 shadow-sm active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <h2 class="text-base font-black text-slate-900">Konfirmasi Pesanan</h2>
        <div class="w-10"></div>
      </header>

      <!-- Customer Form Section -->
      <div class="p-5 bg-gradient-to-b from-indigo-50/70 to-slate-50 border-b border-indigo-100/50 space-y-3">
        <div class="flex items-center justify-between bg-white px-4 py-2.5 rounded-2xl border border-indigo-100 shadow-xs">
          <div class="flex items-center gap-2">
            <span class="text-base">📍</span>
            <div>
              <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Lokasi Meja</p>
              <p id="cart-table-label" class="text-xs font-black text-indigo-700">Meja #--</p>
            </div>
          </div>
          <span class="text-[10px] font-extrabold bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full border border-indigo-100">QR Self-Order</span>
        </div>

        <!-- Dining Option Toggle (Dine In vs Take Away) -->
        <div>
          <label class="block text-[10px] font-black text-slate-500 uppercase tracking-wider mb-1.5">Tipe Pesanan <span class="text-rose-500">*</span></label>
          <div class="grid grid-cols-2 gap-2 bg-slate-100/80 p-1 rounded-2xl border border-slate-200">
            <button 
              type="button" 
              id="opt-dine-in" 
              class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-white text-indigo-700 font-extrabold text-xs shadow-xs transition-all border border-indigo-100"
            >
              <span class="text-sm">🍽️</span>
              <span>Makan di Sini</span>
            </button>
            <button 
              type="button" 
              id="opt-take-away" 
              class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-slate-600 font-bold text-xs transition-all hover:text-slate-900 border border-transparent"
            >
              <span class="text-sm">🥡</span>
              <span>Bawa Pulang</span>
            </button>
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-black text-slate-500 uppercase tracking-wider mb-1">Nama Pemesan <span class="text-rose-500">*</span></label>
          <input 
            type="text" 
            id="cust-name" 
            placeholder="Masukkan nama Anda (Contoh: Budi)" 
            class="w-full px-4 py-3 rounded-2xl bg-white border border-slate-200 text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-600/30 focus:border-indigo-600 shadow-xs"
          />
        </div>

        <div>
          <label class="block text-[10px] font-black text-slate-500 uppercase tracking-wider mb-1">Nomor WhatsApp / HP (Opsional)</label>
          <input 
            type="tel" 
            id="cust-phone" 
            placeholder="08xxxxxxxxxx (untuk kirim invoice / info)" 
            class="w-full px-4 py-3 rounded-2xl bg-white border border-slate-200 text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-600/30 focus:border-indigo-600 shadow-xs"
          />
        </div>

        <div>
          <label class="block text-[10px] font-black text-slate-500 uppercase tracking-wider mb-1">Catatan Tambahan (Opsional)</label>
          <textarea 
            id="order-note" 
            placeholder="Catatan umum pesanan untuk kasir..." 
            class="w-full px-4 py-2.5 rounded-2xl bg-white border border-slate-200 text-xs font-medium text-slate-800 outline-none focus:ring-2 focus:ring-indigo-600/30 focus:border-indigo-600 shadow-xs"
            rows="2"
          ></textarea>
        </div>
      </div>

      <!-- Cart Items -->
      <div id="cart-items-container" class="flex-1 overflow-y-auto p-5 space-y-3.5">
        <!-- Rendered items -->
      </div>

      <!-- Total & Action Button -->
      <div class="p-5 bg-white border-t border-slate-200 shadow-2xl">
        <div class="flex justify-between items-center mb-4">
          <div>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Total Pembayaran</p>
            <p id="cart-final-price" class="text-2xl font-black text-indigo-600">Rp 0</p>
          </div>
          <p id="cart-items-count-text" class="text-[11px] font-bold text-slate-500">0 Menu</p>
        </div>

        <button id="confirm-order-btn" class="w-full btn-gradient text-white py-4 rounded-2xl font-black text-base flex items-center justify-center gap-2">
          <span>Kirim Pesanan Sekarang</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <!-- ORDER HISTORY / STATUS PAGE -->
    <div id="history-page" class="app-page">
      <header class="p-4 flex items-center justify-between glass-nav sticky top-0 z-50">
        <button onclick="window.hidePage('history-page')" class="w-10 h-10 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-800 shadow-sm active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <h2 class="text-base font-black text-slate-900">Riwayat Pesanan Meja</h2>
        <button id="refresh-history-btn" class="w-10 h-10 flex items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 hover:bg-indigo-100 active:scale-95" title="Muat Ulang Status">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
        </button>
      </header>

      <div class="px-5 py-3 bg-amber-50 border-b border-amber-200/60 flex items-center gap-2">
        <span class="text-amber-600 text-xs">ℹ️</span>
        <p class="text-[10px] font-bold text-amber-800 leading-snug">
          Status pesanan di bawah diperbarui otomatis saat diproses kasir & dapur.
        </p>
      </div>

      <div id="history-list" class="flex-1 overflow-y-auto p-5 space-y-4">
        <!-- History items rendered here -->
      </div>
    </div>

    <!-- SUCCESS ORDER MODAL -->
    <div id="success-modal" class="success-modal-overlay">
      <div class="bg-white rounded-[32px] p-6 max-w-sm w-full text-center shadow-2xl border border-slate-100 animate-in">
        <div class="w-16 h-16 rounded-3xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 text-3xl shadow-inner">
          ✓
        </div>
        <span class="text-[10px] font-black text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full uppercase tracking-wider">Terkirim ke Kasir & Dapur</span>
        <h3 class="text-xl font-black text-slate-900 mt-2 mb-1">Pesanan Berhasil!</h3>
        <p id="success-invoice" class="text-xs font-mono font-bold text-slate-400 mb-4">INV-XXXX</p>
        
        <div class="bg-slate-50 p-4 rounded-2xl text-left border border-slate-100 mb-5 space-y-1.5 text-xs">
          <div class="flex justify-between font-bold text-slate-500">
            <span>Nomor Meja:</span>
            <span id="success-table" class="text-slate-800 font-black">Meja #--</span>
          </div>
          <div class="flex justify-between font-bold text-slate-500">
            <span>Pemesan:</span>
            <span id="success-name" class="text-slate-800 font-black">--</span>
          </div>
          <div class="flex justify-between font-bold text-slate-500 pt-1 border-t border-slate-200">
            <span>Total Tagihan:</span>
            <span id="success-total" class="text-indigo-600 font-black text-sm">Rp 0</span>
          </div>
        </div>

        <p class="text-[11px] text-slate-500 font-medium mb-5 leading-relaxed">
          Silakan santai di meja Anda. Pesanan sedang disiapkan, Anda dapat melakukan pembayaran langsung di kasir.
        </p>

        <div class="space-y-2">
          <button id="success-history-btn" class="w-full btn-gradient text-white py-3.5 rounded-2xl font-black text-xs">
            Pantau Status Pesanan (Riwayat)
          </button>
          
          <button id="success-wa-btn" class="w-full bg-emerald-600 text-white py-3 rounded-2xl font-bold text-xs flex items-center justify-center gap-1.5 hidden hover:bg-emerald-700 active:scale-95 transition-all">
            <span>💬 Kirim Rincian ke WhatsApp Toko</span>
          </button>

          <button id="success-close-btn" class="w-full bg-slate-100 text-slate-600 py-3 rounded-2xl font-bold text-xs hover:bg-slate-200 active:scale-95 transition-all">
            Pesan Menu Lainnya
          </button>
        </div>
      </div>
    </div>

    <!-- LOADING OVERLAY -->
    <div id="loading-overlay">
      <div class="w-12 h-12 border-4 border-white/20 border-t-white rounded-full animate-spin mb-4"></div>
      <p id="loading-text" class="font-bold text-sm">Menghubungkan ke Toko...</p>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://kjekiseloobdxomicolo.supabase.co';
    const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtqZWtpc2Vsb29iZHhvbWljb2xvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA1OTM3OTMsImV4cCI6MjEwNjE2OTc5M30.csMbrT-zokTlb1SBplh_xRr9_Cpksk46OSJ0BQZTQB0';
    const supabase = createClient(supabaseUrl, supabaseKey);

    // Parse URL: /order/:outletId/:tableId
    const pathParts = window.location.pathname.split('/').filter(p => p !== "");
    const tableId = pathParts[pathParts.length - 1] || '1';
    const outletId = pathParts[pathParts.length - 2] || '';
    const tableNum = parseInt(tableId);

    if (!outletId) {
      console.error("URL tidak valid, outlet ID tidak ditemukan.");
      alert("Tautan QR tidak valid. Hubungi kasir atau pelayan.");
      window.location.href = "/";
    }

    // App State
    let currentOutlet = null;
    let businessPhone = null;
    let allMenuItems = [];
    let cart = [];
    let activeProduct = null;
    let selectedVariant = null;
    let detailQuantity = 1;
    let activeCategory = 'Semua';
    let searchQuery = '';
    let lastOrderDetails = null;
    let selectedDiningOption = 'dine_in'; // 'dine_in' | 'take_away'

    const formatPrice = (p) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(p || 0);

    // INITIALIZATION
    const initApp = async () => {
      try {
        setLoading(true, "Menghubungkan ke Outlet...");

        // 1. Fetch Outlet & Business Info
        const { data: outlet, error: outletErr } = await supabase
          .from('outlets')
          .select('*, businesses(*)')
          .eq('id', outletId)
          .maybeSingle();

        if (outletErr || !outlet) {
          alert("Outlet atau Meja tidak ditemukan! Silakan scan ulang QR Code.");
          window.location.href = "/";
          return;
        }

        currentOutlet = outlet;
        const bizName = outlet.businesses?.name || outlet.name || 'Mangga POS';
        businessPhone = outlet.phone || outlet.businesses?.phone || null;

        document.getElementById('biz-name').textContent = bizName;
        document.getElementById('biz-logo').textContent = bizName.charAt(0).toUpperCase();
        document.getElementById('table-label').textContent = `Meja #${tableId}`;
        document.getElementById('cart-table-label').textContent = `Meja #${tableId}`;
        document.title = `${bizName} | Meja ${tableId}`;

        // 2. Load Active Menu Items
        setLoading(true, "Memuat Menu Makanan & Minuman...");
        const { data: items, error: itemsErr } = await supabase
          .from('menu_items')
          .select('*, menu_categories(name), variants:menu_item_variants(*)')
          .eq('business_id', outlet.business_id)
          .eq('stock_available', true);

        if (itemsErr) {
          console.error("Error loading menu:", itemsErr);
        }

        if (items && items.length > 0) {
          allMenuItems = items.map(item => ({
            ...item,
            category_name: item.menu_categories?.name || 'Lainnya',
            variants_data: (item.variants || []).filter(v => v.stock_available)
          }));
        } else {
          allMenuItems = [];
        }

        renderCategories();
        renderMenu();
        checkExistingOrdersBadge();
        setupRealtimeOrders();
        setupDiningOptionListeners();

      } catch (err) {
        console.error("Init failed:", err);
        alert("Gagal memuat data menu. Silakan muat ulang halaman.");
      } finally {
        setLoading(false);
      }
    };

    const setupDiningOptionListeners = () => {
      const btnDineIn = document.getElementById('opt-dine-in');
      const btnTakeAway = document.getElementById('opt-take-away');
      const tableLabel = document.getElementById('cart-table-label');

      if (btnDineIn && btnTakeAway) {
        btnDineIn.onclick = () => {
          selectedDiningOption = 'dine_in';
          btnDineIn.className = "flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-white text-indigo-700 font-extrabold text-xs shadow-xs transition-all border border-indigo-100";
          btnTakeAway.className = "flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-slate-600 font-bold text-xs transition-all hover:text-slate-900 border border-transparent";
          if (tableLabel) tableLabel.textContent = `Meja #${tableId}`;
        };

        btnTakeAway.onclick = () => {
          selectedDiningOption = 'take_away';
          btnTakeAway.className = "flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-white text-orange-600 font-extrabold text-xs shadow-xs transition-all border border-orange-200";
          btnDineIn.className = "flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-slate-600 font-bold text-xs transition-all hover:text-slate-900 border border-transparent";
          if (tableLabel) tableLabel.textContent = `🥡 Bungkus (Bawa Pulang)`;
        };
      }
    };

    const setLoading = (show, text = "Memproses...") => {
      const el = document.getElementById('loading-overlay');
      const textEl = document.getElementById('loading-text');
      if (textEl && text) textEl.textContent = text;
      if (el) el.style.display = show ? 'flex' : 'none';
    };

    // RENDER CATEGORIES
    const renderCategories = () => {
      const container = document.getElementById('category-list');
      if (!container) return;

      const categories = ['Semua', ...new Set(allMenuItems.map(i => i.category_name))];
      container.innerHTML = '';

      categories.forEach(cat => {
        const btn = document.createElement('button');
        btn.className = `category-btn whitespace-nowrap px-4 py-2.5 rounded-2xl text-xs font-black border border-slate-200/80 bg-white text-slate-500 shadow-xs ${cat === activeCategory ? 'active' : ''}`;
        btn.textContent = cat;
        btn.onclick = () => {
          activeCategory = cat;
          document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderMenu();
        };
        container.appendChild(btn);
      });
    };

    // RENDER MENU ITEMS
    const renderMenu = () => {
      const container = document.getElementById('menu-grid');
      if (!container) return;

      let filtered = allMenuItems;

      if (activeCategory !== 'Semua') {
        filtered = filtered.filter(i => i.category_name === activeCategory);
      }

      if (searchQuery.trim() !== '') {
        const q = searchQuery.toLowerCase().trim();
        filtered = filtered.filter(i => 
          (i.name && i.name.toLowerCase().includes(q)) ||
          (i.description && i.description.toLowerCase().includes(q)) ||
          (i.category_name && i.category_name.toLowerCase().includes(q))
        );
      }

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="col-span-2 py-16 flex flex-col items-center justify-center text-slate-400">
            <span class="text-4xl mb-3">🔍</span>
            <p class="font-extrabold text-xs text-slate-600 mb-1">Menu Tidak Ditemukan</p>
            <p class="text-[11px] text-slate-400">Coba cari dengan kata kunci lain.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      filtered.forEach(item => {
        const hasVariants = item.variants_data && item.variants_data.length > 0;
        const inCartItems = cart.filter(c => c.id === item.id);
        const inCartQty = inCartItems.reduce((sum, c) => sum + c.quantity, 0);
        const isInCart = inCartQty > 0;

        const div = document.createElement('div');
        div.setAttribute('data-product-id', item.id);
        div.className = `bg-white p-3 rounded-[24px] border ${isInCart ? 'border-emerald-400 ring-2 ring-emerald-400/25 bg-emerald-50/10' : 'border-slate-200/70'} shadow-xs flex flex-col justify-between active:scale-[0.98] transition-all relative group`;

        div.innerHTML = `
          <div class="product-click-area cursor-pointer">
            <div class="product-img-wrapper aspect-square rounded-[18px] overflow-hidden bg-slate-100 mb-3 relative flex items-center justify-center">
              ${item.image_url 
                ? `<img src="${item.image_url}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="${item.name}" loading="lazy" />` 
                : `<span class="text-4xl opacity-30 select-none">🍽️</span>`}
              ${hasVariants ? `<span class="absolute top-2 left-2 bg-indigo-600/90 backdrop-blur-xs text-white text-[9px] font-black px-2 py-0.5 rounded-lg shadow-xs">${item.variants_data.length} Varian</span>` : ''}
              ${isInCart ? `
                <div class="cart-item-badge absolute top-2 right-2 bg-emerald-600 text-white text-[9px] font-black px-2 py-0.5 rounded-full shadow-md flex items-center gap-1 animate-scale-in">
                  <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>${inCartQty}x</span>
                </div>
              ` : ''}
            </div>
            <div>
              <h3 class="font-extrabold text-slate-900 text-xs mb-1 line-clamp-2 leading-tight">${item.name}</h3>
              <p class="text-[12px] font-black text-indigo-600 mb-1">${formatPrice(item.price)}</p>
            </div>
          </div>

          <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[9px] font-bold text-slate-400">${item.category_name}</span>
            <div class="product-action-area">
              ${isInCart ? `
                <div class="flex items-center gap-1.5 bg-emerald-50 px-2 py-1 rounded-xl border border-emerald-200">
                  <span class="text-[10px] font-black text-emerald-700">${inCartQty}x</span>
                  <button class="quick-add-btn w-6 h-6 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center font-bold text-xs shadow-xs active:scale-90 transition-all" title="Tambah lagi">
                    +
                  </button>
                </div>
              ` : `
                <button class="quick-add-btn w-8 h-8 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white flex items-center justify-center font-bold text-base shadow-xs active:scale-90 transition-all" title="Tambah">
                  +
                </button>
              `}
            </div>
          </div>
        `;

        div.querySelector('.product-click-area').onclick = () => openDetail(item);
        div.querySelector('.quick-add-btn').onclick = (e) => {
          e.stopPropagation();
          if (hasVariants) {
            openDetail(item);
          } else {
            addToCart(item, null, "", 1);
            triggerCartAnimation();
          }
        };

        container.appendChild(div);
      });
    };

    // UPDATE MENU BADGES IN-PLACE WITHOUT REBUILDING DOM
    const updateMenuCartBadges = () => {
      const container = document.getElementById('menu-grid');
      if (!container) return;

      const cards = container.querySelectorAll('[data-product-id]');
      cards.forEach(card => {
        const pId = card.getAttribute('data-product-id');
        const inCartItems = cart.filter(c => c.id === pId);
        const inCartQty = inCartItems.reduce((sum, c) => sum + c.quantity, 0);
        const isInCart = inCartQty > 0;

        // 1. Toggle border & background styling
        if (isInCart) {
          card.classList.add('border-emerald-400', 'ring-2', 'ring-emerald-400/25', 'bg-emerald-50/10');
          card.classList.remove('border-slate-200/70');
        } else {
          card.classList.remove('border-emerald-400', 'ring-2', 'ring-emerald-400/25', 'bg-emerald-50/10');
          card.classList.add('border-slate-200/70');
        }

        // 2. Image badge
        const imgWrapper = card.querySelector('.product-img-wrapper');
        if (imgWrapper) {
          let badge = imgWrapper.querySelector('.cart-item-badge');
          if (isInCart) {
            if (!badge) {
              badge = document.createElement('div');
              badge.className = 'cart-item-badge absolute top-2 right-2 bg-emerald-600 text-white text-[9px] font-black px-2 py-0.5 rounded-full shadow-md flex items-center gap-1 animate-scale-in';
              imgWrapper.appendChild(badge);
            }
            badge.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>${inCartQty}x</span>
            `;
          } else if (badge) {
            badge.remove();
          }
        }

        // 3. Action button area
        const actionArea = card.querySelector('.product-action-area');
        if (actionArea) {
          const item = allMenuItems.find(i => i.id === pId);
          const hasVariants = item?.variants_data && item.variants_data.length > 0;
          
          if (isInCart) {
            actionArea.innerHTML = `
              <div class="flex items-center gap-1.5 bg-emerald-50 px-2 py-1 rounded-xl border border-emerald-200">
                <span class="text-[10px] font-black text-emerald-700">${inCartQty}x</span>
                <button class="quick-add-btn w-6 h-6 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center font-bold text-xs shadow-xs active:scale-90 transition-all" title="Tambah lagi">
                  +
                </button>
              </div>
            `;
          } else {
            actionArea.innerHTML = `
              <button class="quick-add-btn w-8 h-8 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white flex items-center justify-center font-bold text-base shadow-xs active:scale-90 transition-all" title="Tambah">
                +
              </button>
            `;
          }

          actionArea.querySelector('.quick-add-btn').onclick = (e) => {
            e.stopPropagation();
            if (hasVariants) {
              openDetail(item);
            } else {
              addToCart(item, null, "", 1);
              triggerCartAnimation();
            }
          };
        }
      });
    };

    // SEARCH LISTENER
    const searchInput = document.getElementById('search-input');
    const clearSearchBtn = document.getElementById('clear-search-btn');

    if (searchInput) {
      searchInput.oninput = (e) => {
        searchQuery = e.target.value;
        if (clearSearchBtn) clearSearchBtn.style.display = searchQuery ? 'flex' : 'none';
        renderMenu();
      };
    }
    if (clearSearchBtn) {
      clearSearchBtn.onclick = () => {
        searchQuery = '';
        searchInput.value = '';
        clearSearchBtn.style.display = 'none';
        renderMenu();
      };
    }

    // DETAIL MODAL
    const openDetail = (item) => {
      activeProduct = item;
      selectedVariant = item.variants_data.length > 0 ? item.variants_data[0] : null;
      detailQuantity = 1;

      document.getElementById('detail-name').textContent = item.name;
      document.getElementById('detail-desc').textContent = item.description || 'Menu lezat pilihan terbaik untuk Anda.';
      document.getElementById('detail-note').value = '';
      document.querySelectorAll('.quick-note-chip').forEach(btn => {
        btn.classList.remove('bg-indigo-50', 'text-indigo-700', 'border-indigo-400');
        btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
      });
      document.getElementById('detail-qty').textContent = detailQuantity;

      const imgEl = document.getElementById('detail-img');
      const fallbackEl = document.getElementById('detail-img-fallback');
      if (item.image_url) {
        imgEl.src = item.image_url;
        imgEl.classList.remove('hidden');
        fallbackEl.classList.add('hidden');
      } else {
        imgEl.classList.add('hidden');
        fallbackEl.classList.remove('hidden');
      }

      updateDetailPrice();

      // Variants
      const vSec = document.getElementById('detail-variants-section');
      const vList = document.getElementById('detail-variants-list');
      vList.innerHTML = '';

      if (item.variants_data && item.variants_data.length > 0) {
        vSec.classList.remove('hidden');
        item.variants_data.forEach((v, idx) => {
          const btn = document.createElement('button');
          btn.className = `px-3.5 py-2 rounded-xl text-xs font-bold border transition-all ${idx === 0 ? 'border-indigo-600 bg-indigo-50/70 text-indigo-700' : 'border-slate-200 bg-white text-slate-600'}`;
          btn.innerHTML = `${v.name} <span class="text-[10px] font-black text-indigo-600 ml-1">${formatPrice(v.price)}</span>`;
          
          btn.onclick = () => {
            vList.querySelectorAll('button').forEach(b => {
              b.className = 'px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-600 transition-all';
            });
            btn.className = 'px-3.5 py-2 rounded-xl text-xs font-bold border-indigo-600 bg-indigo-50/70 text-indigo-700 transition-all';
            selectedVariant = v;
            updateDetailPrice();
          };
          vList.appendChild(btn);
        });
      } else {
        vSec.classList.add('hidden');
      }

      window.showPage('detail-page');
    };

    const updateDetailPrice = () => {
      const price = selectedVariant?.price || activeProduct?.price || 0;
      document.getElementById('detail-price').textContent = formatPrice(price * detailQuantity);
    };

    document.getElementById('qty-minus-btn').onclick = () => {
      if (detailQuantity > 1) {
        detailQuantity--;
        document.getElementById('detail-qty').textContent = detailQuantity;
        updateDetailPrice();
      }
    };
    document.getElementById('qty-plus-btn').onclick = () => {
      detailQuantity++;
      document.getElementById('detail-qty').textContent = detailQuantity;
      updateDetailPrice();
    };

    document.getElementById('add-to-cart-btn').onclick = () => {
      if (!activeProduct) return;
      if (activeProduct.variants_data.length > 0 && !selectedVariant) {
        return alert('Silakan pilih salah satu varian terlebih dahulu.');
      }
      const notes = (document.getElementById('detail-note') as HTMLTextAreaElement).value;
      addToCart(activeProduct, selectedVariant, notes, detailQuantity);
      window.hidePage('detail-page');
      triggerCartAnimation();
    };

    // Quick note chip handlers
    document.querySelectorAll('.quick-note-chip').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = btn.getAttribute('data-note');
        const noteEl = document.getElementById('detail-note') as HTMLTextAreaElement;
        if (!noteEl || !tag) return;
        let val = noteEl.value.trim();
        if (val.includes(tag)) {
          const parts = val.split(/,\s*/).filter(p => p.trim() !== tag && p.trim().length > 0);
          val = parts.join(', ');
          btn.classList.remove('bg-indigo-50', 'text-indigo-700', 'border-indigo-400');
          btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        } else {
          val = val ? `${val}, ${tag}` : tag;
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
          btn.classList.add('bg-indigo-50', 'text-indigo-700', 'border-indigo-400');
        }
        noteEl.value = val;
      });
    });

    const noteTextarea = document.getElementById('detail-note');
    if (noteTextarea) {
      noteTextarea.addEventListener('input', (e) => {
        const val = (e.target as HTMLTextAreaElement).value;
        document.querySelectorAll('.quick-note-chip').forEach(btn => {
          const tag = btn.getAttribute('data-note');
          if (tag && val.includes(tag)) {
            btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
            btn.classList.add('bg-indigo-50', 'text-indigo-700', 'border-indigo-400');
          } else {
            btn.classList.remove('bg-indigo-50', 'text-indigo-700', 'border-indigo-400');
            btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
          }
        });
      });
    }

    // CART LOGIC
    const addToCart = (item, variant, notes, qty = 1) => {
      const cleanNote = (notes || "").trim();
      const vId = variant?.id || null;
      const vName = variant?.name || null;
      const itemPrice = variant?.price || item.price;

      const existing = cart.find(i => i.id === item.id && i.variantId === vId && (i.notes || "").trim() === cleanNote);
      if (existing) {
        existing.quantity += qty;
      } else {
        cart.push({
          id: item.id,
          variantId: vId,
          name: item.name,
          variantName: vName,
          price: itemPrice,
          quantity: qty,
          notes: cleanNote
        });
      }
      updateUI();
    };

    window.changeQty = (idx, delta) => {
      if (!cart[idx]) return;
      cart[idx].quantity += delta;
      if (cart[idx].quantity <= 0) {
        cart.splice(idx, 1);
      }
      updateUI();
    };

    const triggerCartAnimation = () => {
      const badge = document.getElementById('cart-count-badge');
      if (badge) {
        badge.classList.remove('pop-badge');
        void badge.offsetWidth; // trigger reflow
        badge.classList.add('pop-badge');
      }
    };

    const updateUI = () => {
      const totalQty = cart.reduce((sum, i) => sum + i.quantity, 0);
      const totalPrice = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);

      // Bottom bar
      const cartBar = document.getElementById('cart-bar');
      if (cartBar) cartBar.classList.toggle('visible', totalQty > 0);

      // Top nav badge
      const countBadge = document.getElementById('cart-count-badge');
      if (countBadge) {
        countBadge.classList.toggle('hidden', totalQty === 0);
        countBadge.textContent = totalQty;
      }

      document.getElementById('cart-total-qty').textContent = totalQty;
      document.getElementById('cart-total-price').textContent = formatPrice(totalPrice);
      document.getElementById('cart-final-price').textContent = formatPrice(totalPrice);
      document.getElementById('cart-items-count-text').textContent = `${totalQty} Menu (${cart.length} Jenis)`;

      // Cart items list
      const container = document.getElementById('cart-items-container');
      if (!container) return;

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="py-16 text-center text-slate-400">
            <span class="text-4xl mb-3 block">🛒</span>
            <p class="font-bold text-xs text-slate-600 mb-1">Keranjang Masih Kosong</p>
            <p class="text-[11px] text-slate-400">Silakan pilih menu favorit Anda di halaman utama.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      cart.forEach((item, idx) => {
        const div = document.createElement('div');
        div.className = 'bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs space-y-2';
        div.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1">
              <h4 class="font-extrabold text-slate-900 text-xs leading-tight">${item.name}</h4>
              ${item.variantName ? `<span class="inline-block bg-indigo-50 text-indigo-700 text-[9px] font-black px-2 py-0.5 rounded-md mt-1">${item.variantName}</span>` : ''}
              <p class="text-xs font-black text-indigo-600 mt-1">${formatPrice(item.price)}</p>
            </div>
            <div class="flex items-center gap-2 bg-slate-50 px-2 py-1 rounded-xl border border-slate-200">
              <button onclick="window.changeQty(${idx}, -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-700 font-bold active:scale-90">-</button>
              <span class="font-black text-xs w-4 text-center text-slate-800">${item.quantity}</span>
              <button onclick="window.changeQty(${idx}, 1)" class="w-6 h-6 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold active:scale-90">+</button>
            </div>
          </div>
          ${item.notes ? `<div class="flex items-center gap-1.5 bg-amber-50/80 border border-amber-200/60 px-2.5 py-1.5 rounded-xl text-[10px] font-bold text-amber-900 mt-2"><span>📝</span><span>${item.notes}</span></div>` : ''}
          <div class="flex justify-between items-center pt-2 border-t border-slate-100 text-[11px]">
            <span class="text-slate-400 font-medium">Subtotal</span>
            <span class="font-black text-slate-800">${formatPrice(item.price * item.quantity)}</span>
          </div>
        `;
        container.appendChild(div);
      });

      // Synchronize product card badges in menu grid
      updateMenuCartBadges();
    };

    // NAVIGATION SYSTEM
    window.showPage = (id) => {
      const page = document.getElementById(id);
      if (page) {
        page.classList.add('active');
        if (id === 'history-page') window.loadHistory();
      }
    };

    window.hidePage = (id) => {
      const page = document.getElementById(id);
      if (page) page.classList.remove('active');
    };

    // CONFIRM ORDER ACTION
    const confirmBtn = document.getElementById('confirm-order-btn');
    confirmBtn.onclick = async () => {
      if (cart.length === 0) {
        alert("Keranjang Anda masih kosong. Silakan tambahkan menu terlebih dahulu.");
        return;
      }

      const name = (document.getElementById('cust-name').value || '').trim();
      if (!name) {
        alert("Mohon masukkan Nama Anda untuk konfirmasi pesanan.");
        document.getElementById('cust-name').focus();
        return;
      }

      const phone = (document.getElementById('cust-phone').value || '').trim();
      const orderNote = (document.getElementById('order-note').value || '').trim();

      // Set button to loading state
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = `
        <div class="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin"></div>
        <span>Mengirim ke Dapur...</span>
      `;
      setLoading(true, "Mengirim pesanan ke kasir...");

      try {
        const payload = cart.map(i => ({
          menu_item_id: i.id,
          variant_id: i.variantId || null,
          quantity: i.quantity,
          notes: i.notes || ''
        }));

        // Call database RPC directly
        const { data: newOrderId, error } = await supabase.rpc('create_self_order', {
          target_outlet_id: outletId,
          target_table_number: isNaN(tableNum) ? 0 : tableNum,
          target_customer_name: name,
          target_customer_phone: phone || null,
          target_customer_email: null,
          items_payload: payload,
          target_table_key: tableId
        });

        if (error) {
          console.error("Order RPC error:", error);
          throw error;
        }

        // Update dining_option and note tag in Supabase
        try {
          const isTakeAway = selectedDiningOption === 'take_away';
          const fullNotes = [
            isTakeAway ? '[TAKEAWAY]' : '[DINE-IN]',
            orderNote ? `Catatan: ${orderNote}` : ''
          ].filter(Boolean).join(' | ');

          await supabase.from('orders').update({
            dining_option: selectedDiningOption,
            notes: fullNotes
          }).eq('id', newOrderId);
        } catch (updateErr) {
          console.warn("Could not update dining_option on order:", updateErr);
        }

        // Simpan ID pesanan di localStorage
        const storedOrders = JSON.parse(localStorage.getItem(`orders_${outletId}`) || '[]');
        if (!storedOrders.includes(newOrderId)) {
          storedOrders.push(newOrderId);
          localStorage.setItem(`orders_${outletId}`, JSON.stringify(storedOrders));
        }

        const grandTotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
        lastOrderDetails = {
          orderId: newOrderId,
          customerName: name,
          customerPhone: phone,
          tableId: tableId,
          grandTotal: grandTotal,
          items: [...cart],
          note: orderNote
        };

        // Reset Cart
        cart = [];
        updateUI();
        window.hidePage('cart-page');
        checkExistingOrdersBadge();

        // Show Success Modal
        showSuccessModal(lastOrderDetails);

      } catch (err) {
        console.error("Gagal submit pesanan:", err);
        alert("Gagal mengirim pesanan: " + (err.message || "Koneksi terputus. Silakan coba lagi."));
      } finally {
        setLoading(false);
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = `
          <span>Kirim Pesanan Sekarang</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        `;
      }
    };

    // SUCCESS MODAL HANDLERS
    const showSuccessModal = (details) => {
      const modal = document.getElementById('success-modal');
      if (!modal) return;

      document.getElementById('success-table').textContent = `Meja #${details.tableId}`;
      document.getElementById('success-name').textContent = details.customerName;
      document.getElementById('success-total').textContent = formatPrice(details.grandTotal);
      document.getElementById('success-invoice').textContent = details.orderId ? `ID: ${details.orderId.substring(0, 8).toUpperCase()}` : '';

      // Setup WA button jika nomor toko ada
      const waBtn = document.getElementById('success-wa-btn');
      if (businessPhone) {
        waBtn.classList.remove('hidden');
        waBtn.onclick = () => {
          let cleanPhone = businessPhone.replace(/\D/g, '');
          if (cleanPhone.startsWith('0')) cleanPhone = '62' + cleanPhone.substring(1);
          
          let itemsText = details.items.map(i => `• ${i.quantity}x ${i.name}${i.variantName ? ' (' + i.variantName + ')' : ''} - ${formatPrice(i.price * i.quantity)}`).join('\n');
          const msg = `Halo ${currentOutlet?.name || 'Kasir'}, saya baru saja memesan via QR Self-Order:\n\n*Meja*: #${details.tableId}\n*Nama*: ${details.customerName}\n*Total*: ${formatPrice(details.grandTotal)}\n\n*Menu Pesanan*:\n${itemsText}\n\nMohon diproses ya, terima kasih!`;
          
          const waUrl = `https://api.whatsapp.com/send/?phone=${cleanPhone}&text=${encodeURIComponent(msg)}`;
          window.location.href = waUrl;
        };
      } else {
        waBtn.classList.add('hidden');
      }

      document.getElementById('success-history-btn').onclick = () => {
        modal.classList.remove('active');
        window.showPage('history-page');
      };

      document.getElementById('success-close-btn').onclick = () => {
        modal.classList.remove('active');
      };

      modal.classList.add('active');
    };

    // HISTORY PAGE LOGIC
    window.loadHistory = async () => {
      const container = document.getElementById('history-list');
      if (!container) return;

      const ids = JSON.parse(localStorage.getItem(`orders_${outletId}`) || '[]');

      container.innerHTML = `
        <div class="py-12 flex justify-center">
          <div class="w-8 h-8 border-3 border-slate-200 border-t-indigo-600 rounded-full animate-spin"></div>
        </div>
      `;

      try {
        const { data, error } = await supabase.rpc('get_self_order_history', {
          target_outlet_id: outletId,
          known_order_ids: ids,
          target_table_key: tableId,
          target_table_number: isNaN(tableNum) ? null : tableNum
        });

        if (error) throw error;

        if (!data || data.length === 0) {
          container.innerHTML = `
            <div class="py-20 text-center text-slate-400">
              <span class="text-4xl mb-3 block">📜</span>
              <p class="font-bold text-xs text-slate-600 mb-1">Belum Ada Riwayat Pesanan</p>
              <p class="text-[11px] text-slate-400">Pesanan yang dibuat di Meja #${tableId} akan muncul di sini.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = '';
        data.forEach(order => {
          const div = document.createElement('div');
          div.className = 'bg-white p-5 rounded-[24px] border border-slate-200/80 shadow-xs space-y-3';
          
          let statusBadgeClass = 'badge-confirmed';
          let statusLabel = 'Menunggu Kasir';

          switch (order.status) {
            case 'confirmed':
              statusBadgeClass = 'badge-confirmed';
              statusLabel = '🕒 Diterima / Menunggu Kasir';
              break;
            case 'processing':
              statusBadgeClass = 'badge-processing';
              statusLabel = '🍳 Sedang Dimasak';
              break;
            case 'ready':
              statusBadgeClass = 'badge-ready';
              statusLabel = '🔔 Siap Disajikan';
              break;
            case 'completed':
              statusBadgeClass = 'badge-completed';
              statusLabel = '✅ Selesai / Lunas';
              break;
            case 'cancelled':
              statusBadgeClass = 'badge-cancelled';
              statusLabel = '❌ Dibatalkan';
              break;
            default:
              statusLabel = order.status;
          }

          const itemsHtml = (order.order_items || []).map(i => `
            <div class="flex justify-between items-center text-xs">
              <span class="font-bold text-slate-700">${i.quantity}x ${i.name}${i.variant_name ? ' (' + i.variant_name + ')' : ''}</span>
              <span class="font-medium text-slate-500">${formatPrice(i.subtotal)}</span>
            </div>
          `).join('');

          div.innerHTML = `
            <div class="flex justify-between items-center pb-2.5 border-b border-slate-100">
              <div>
                <span class="text-[9px] font-mono font-bold text-slate-400 tracking-wider">${order.invoice_number}</span>
                <p class="text-[10px] font-bold text-slate-500">Meja #${order.table_number || tableId}</p>
              </div>
              <span class="badge-status ${statusBadgeClass}">${statusLabel}</span>
            </div>

            <div class="space-y-1.5 py-1">
              ${itemsHtml}
            </div>

            <div class="pt-2.5 border-t border-slate-100 flex justify-between items-center">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total</span>
              <span class="text-sm font-black text-indigo-600">${formatPrice(order.grand_total)}</span>
            </div>
          `;

          container.appendChild(div);
        });

      } catch (err) {
        console.error("Gagal muat histori:", err);
        container.innerHTML = `
          <div class="p-4 bg-rose-50 rounded-2xl text-rose-700 text-xs font-bold text-center">
            Gagal memuat status pesanan. Ketuk tombol refresh di atas untuk coba lagi.
          </div>
        `;
      }
    };

    document.getElementById('refresh-history-btn').onclick = () => window.loadHistory();

    const checkExistingOrdersBadge = async () => {
      try {
        const ids = JSON.parse(localStorage.getItem(`orders_${outletId}`) || '[]');
        const { data, error } = await supabase.rpc('get_self_order_history', {
          target_outlet_id: outletId,
          known_order_ids: ids,
          target_table_key: tableId,
          target_table_number: isNaN(tableNum) ? null : tableNum
        });

        if (error) {
          console.warn("Could not check table orders:", error);
          return;
        }

        const activeOrders = (data || []).filter(o => o.status === 'confirmed' && !o.paid_at);
        const dot = document.getElementById('history-dot');
        const banner = document.getElementById('active-table-banner');

        if (activeOrders.length > 0) {
          const activeOrder = activeOrders[0];
          // Save active order ID to localStorage if not yet present
          if (!ids.includes(activeOrder.id)) {
            ids.push(activeOrder.id);
            localStorage.setItem(`orders_${outletId}`, JSON.stringify(ids));
          }

          if (dot) dot.classList.remove('hidden');
          if (banner) {
            banner.classList.remove('hidden');
            const titleEl = document.getElementById('active-banner-title');
            const descEl = document.getElementById('active-banner-desc');
            if (titleEl) titleEl.textContent = `Meja #${tableId} (${activeOrder.invoice_number})`;
            if (descEl) descEl.textContent = `Tagihan: ${formatPrice(activeOrder.grand_total)} • Menu baru otomatis digabung`;
          }
        } else {
          if (dot) dot.classList.toggle('hidden', (data || []).length === 0);
          if (banner) banner.classList.add('hidden');
        }
      } catch (e) {
        console.warn("Error checkExistingOrdersBadge:", e);
      }
    };

    // REALTIME SUBSCRIPTION FOR TABLE ORDERS
    const setupRealtimeOrders = () => {
      const channel = supabase.channel(`realtime_table_${outletId}_${tableId}`)
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'orders',
          filter: `outlet_id=eq.${outletId}`
        }, (payload) => {
          checkExistingOrdersBadge();
          // If customer is on history page, refresh automatically
          const histPage = document.getElementById('history-page');
          if (histPage && histPage.classList.contains('active')) {
            window.loadHistory();
          }
        })
        .subscribe();
    };

    // RUN INIT
    initApp();
  </script>
</Layout>
