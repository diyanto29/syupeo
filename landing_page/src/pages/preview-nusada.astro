	<!-- Client-Side Interactive Scripts (Slider, 3D Stack Deck & Modal) -->
	<script is:inline>
		// 1. Mobile Menu Toggle
		const menuBtn = document.getElementById('mobile-menu-btn');
		const mobileMenu = document.getElementById('mobile-menu');
		const hamburgerIcon = document.getElementById('hamburger-icon');
		const mobileLinks = document.querySelectorAll('.mobile-link');

		if (menuBtn && mobileMenu) {
			menuBtn.addEventListener('click', () => {
				const isHidden = mobileMenu.classList.toggle('hidden');
				if (hamburgerIcon) {
					hamburgerIcon.className = isHidden ? 'fas fa-bars text-xl' : 'fas fa-times text-xl';
				}
			});

			mobileLinks.forEach(link => {
				link.addEventListener('click', () => {
					mobileMenu.classList.add('hidden');
					if (hamburgerIcon) {
						hamburgerIcon.className = 'fas fa-bars text-xl';
					}
				});
			});
		}

		// 2. Hero Image Slider (Auto + Prev/Next + Dots)
		const slides = document.querySelectorAll('#hero-slider .slide-item');
		const dots = document.querySelectorAll('#slider-dots .dot');
		let currentSlide = 0;
		let slideInterval;

		function showSlide(index) {
			slides.forEach((slide, i) => {
				if (i === index) {
					slide.style.opacity = '1';
					slide.style.pointerEvents = 'auto';
				} else {
					slide.style.opacity = '0';
					slide.style.pointerEvents = 'none';
				}
			});
			dots.forEach((dot, i) => {
				if (i === index) {
					dot.classList.add('w-6', 'bg-white');
					dot.classList.remove('w-2', 'bg-white/50');
				} else {
					dot.classList.remove('w-6', 'bg-white');
					dot.classList.add('w-2', 'bg-white/50');
				}
			});
			currentSlide = index;
		}

		function nextSlide() {
			const next = (currentSlide + 1) % slides.length;
			showSlide(next);
		}

		function prevSlide() {
			const prev = (currentSlide - 1 + slides.length) % slides.length;
			showSlide(prev);
		}

		const btnNext = document.getElementById('slider-next');
		const btnPrev = document.getElementById('slider-prev');
		if (btnNext) btnNext.addEventListener('click', () => { nextSlide(); resetSlideInterval(); });
		if (btnPrev) btnPrev.addEventListener('click', () => { prevSlide(); resetSlideInterval(); });

		dots.forEach((dot, i) => {
			dot.addEventListener('click', () => { showSlide(i); resetSlideInterval(); });
		});

		function startSlideInterval() {
			slideInterval = setInterval(nextSlide, 4500);
		}
		function resetSlideInterval() {
			clearInterval(slideInterval);
			startSlideInterval();
		}
		startSlideInterval();

		// 3. 3D Card Stack Animation (Signature NusaDa Feature)
		const cards = document.querySelectorAll('.stack-card');
		const deckDots = document.querySelectorAll('.deck-dot');
		const deckCounter = document.getElementById('deck-counter');
		let currentDeck = 0;
		const totalCards = cards.length;

		function updateDeck(activeIdx) {
			cards.forEach((card, i) => {
				const pos = (i - activeIdx + totalCards) % totalCards;
				if (pos === 0) {
					// Front active card
					card.style.transform = 'rotate(0deg) translate(0px, 0px)';
					card.style.zIndex = '30';
					card.style.opacity = '1';
				} else if (pos === 1) {
					// Behind 1
					card.style.transform = 'rotate(5deg) translate(16px, 10px)';
					card.style.zIndex = '20';
					card.style.opacity = '0.75';
				} else if (pos === 2) {
					// Behind 2
					card.style.transform = 'rotate(9deg) translate(30px, 20px)';
					card.style.zIndex = '10';
					card.style.opacity = '0.45';
				} else {
					card.style.transform = 'rotate(12deg) translate(36px, 24px)';
					card.style.zIndex = '5';
					card.style.opacity = '0';
				}
			});

			deckDots.forEach((d, i) => {
				if (i === activeIdx) {
					d.classList.add('w-6', 'bg-emerald-600');
					d.classList.remove('w-2', 'bg-slate-300');
				} else {
					d.classList.remove('w-6', 'bg-emerald-600');
					d.classList.add('w-2', 'bg-slate-300');
				}
			});

			if (deckCounter) {
				deckCounter.textContent = `${activeIdx + 1} / ${totalCards}`;
			}
			currentDeck = activeIdx;
		}

		cards.forEach((card) => {
			card.addEventListener('click', () => {
				const nextDeck = (currentDeck + 1) % totalCards;
				updateDeck(nextDeck);
			});
		});

		deckDots.forEach((d, i) => {
			d.addEventListener('click', () => {
				updateDeck(i);
			});
		});

		// 4. All Features Modal Dialog
		const btnShowAll = document.getElementById('btn-show-all-features');
		const modal = document.getElementById('all-features-modal');
		const btnCloseModal = document.getElementById('btn-close-modal');

		if (btnShowAll && modal && btnCloseModal) {
			btnShowAll.addEventListener('click', () => {
				modal.classList.remove('hidden');
			});
			btnCloseModal.addEventListener('click', () => {
				modal.classList.add('hidden');
			});
			modal.addEventListener('click', (e) => {
				if (e.target === modal) {
					modal.classList.add('hidden');
				}
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
					modal.classList.add('hidden');
				}
			});
		}
	</script>
</Layout>
