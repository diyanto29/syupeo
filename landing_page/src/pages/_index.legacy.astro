		async function refreshPricingFromDB() {
			try {
				const res = await fetch(`${supabaseUrl}/rest/v1/subscription_plans?select=*`, {
					headers: {
						apikey: supabaseAnonKey,
						Authorization: `Bearer ${supabaseAnonKey}`
					}
				});
				if (!res.ok) return;
				const plans = await res.json();
				const free = plans.find((p) => p.code === 'free');
				if (free) {
					const prodEl = document.getElementById('free-plan-products');
					if (prodEl && free.max_products) prodEl.textContent = free.max_products;
					const txEl = document.getElementById('free-plan-transactions');
					if (txEl && free.max_transactions_month) txEl.textContent = free.max_transactions_month;
				}
			} catch (e) {
				// Silent fallback
			}
		}

		if (typeof window !== 'undefined') {
			window.addEventListener('DOMContentLoaded', refreshPricingFromDB);
		}
	</script>
