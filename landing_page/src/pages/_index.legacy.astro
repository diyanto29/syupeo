---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Inisialisasi fallback default jika database offline saat build
let freePlan = {
	max_products: 50,
	max_transactions_month: 500,
	max_outlets: 1,
};

let proPlan = {
	price_monthly: 35000,
	tiers: [
		{ code: '1_month', name: '1 Bulan (Bulanan Dasar)', price: 35000, subtitle: '/bln', is_active: true },
		{ code: '6_months', name: '6 Bulan', price: 99000, badge: 'HEMAT 34%', subtitle: '/6 bln', is_active: true },
		{ code: '12_months', name: '1 Tahun (12 Bulan)', price: 180000, badge: 'HEMAT 28%', subtitle: '/thn', is_active: true },
	]
};

try {
	const { data: plans, error } = await supabase.from('subscription_plans').select('*');
	if (plans && !error) {
		const free = plans.find((p: any) => p.code === 'free');
		if (free) {
			freePlan = {
				max_products: free.max_products ?? 50,
				max_transactions_month: free.max_transactions_month ?? 500,
				max_outlets: free.max_outlets ?? 1,
			};
		}

		const pro = plans.find((p: any) => p.code === 'pro');
		if (pro) {
			proPlan.price_monthly = pro.price_monthly ?? 35000;
			if (pro.pricing_tiers && Array.isArray(pro.pricing_tiers.tiers)) {
				proPlan.tiers = pro.pricing_tiers.tiers.filter((t: any) => t.is_active !== false);
			}
		}
	}
} catch (e) {
	console.error('Error fetching subscription_plans from DB:', e);
}

const formatRupiah = (val: number) => {
	return 'Rp ' + Number(val).toLocaleString('id-ID');
};
